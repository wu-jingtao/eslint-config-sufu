{
    "name": "eslint-config-sufu",
    "version": "3.1.8",
    "description": "一套我自己用着觉得舒服的 eslint 规则",
    "keywords": [
        "eslint",
        "eslintconfig",
        "sufu"
    ],
    "author": "wu-jingtao",
    "license": "MIT",
    "homepage": "https://github.com/wu-jingtao/eslint-config-sufu#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wu-jingtao/eslint-config-sufu.git"
    },
    "bugs": {
        "url": "https://github.com/wu-jingtao/eslint-config-sufu/issues"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "compile": "tsc",
        "lint": "eslint --max-warnings 0 src/**/*.ts",
        "lint-fix": "npm run lint -- --fix",
        "check_rule_update": "node ./dist/tools/check_rules_update.js",
        "lint_test": "eslint --max-warnings 0 \".temp/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue}\""
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "glob": "^13.0.6",
        "log-formatter": "^2.1.3",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.10.0",
        "eslint-plugin-jsdoc": "^64.3.6",
        "eslint-plugin-vue": "^10.11.0",
        "tslib": "^2.8.1",
        "typescript-eslint": "^8.69.0"
    }
}
